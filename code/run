#!/usr/bin/env bash
set -ex
# Entry point of the Reproducible Run.
# Default (FULL=0): figures and tables are rebuilt from the cached simulation (data/sim_ch6.rds);
#   the real-data pipeline runs with reduced settings (8 subsamples x 100 trees) as a quick check.
# FULL=1: the simulations are rerun and the real-data pipeline uses the settings of the paper
#   (20 subsamples x 200 trees). Runtime depends on the hardware and may take several hours.
export FULL=0
export CODE_DIR=/code
export OUT_DIR=/results
cd /code

Rscript 01_exact_simul_figures.R          > /results/log_01_exact_simul_figures.txt          2>&1  # exact recursion (Table 1, Extended Data Table 1, ExtDataTable1_exact_moments.csv), simulation cache, Figs. 2-4, Extended Data Figs. 1-3
Rscript 02_closed_forms.R                 > /results/log_02_closed_forms.txt                 2>&1  # Theorem 5 and Supplementary Note 4 against the recursion
Rscript 03_supp_table1.R                  > /results/log_03_supp_table1.txt                  2>&1  # Supplementary Table 1
Rscript 04_realdata.R                     > /results/log_04_realdata.txt                     2>&1  # components files for Table 2, Extended Data Table 2 and Fig. 4
Rscript 05_table2_extdata_table2.R        > /results/log_05_table2_extdata_table2.txt        2>&1  # Table 2 and Extended Data Table 2
Rscript 06_supp_table2_forest.R           > /results/log_06_supp_table2_forest.txt           2>&1  # Supplementary Table 2
Rscript 07_supp_table3_copula.R           > /results/log_07_supp_table3_copula.txt           2>&1  # Supplementary Table 3
Rscript 08_supp_tables4_5_split_rules.R   > /results/log_08_supp_tables4_5_split_rules.txt   2>&1  # Supplementary Tables 4-5
Rscript 09_supp_table6_zeta_limits.R      > /results/log_09_supp_table6_zeta_limits.txt      2>&1  # Supplementary Note 11, Supplementary Table 6
Rscript 10_supp_tables7_9_maximal_state.R > /results/log_10_supp_tables7_9_maximal_state.txt 2>&1  # Supplementary Note 12, Supplementary Tables 7-9
Rscript 11_supp_note11_third_moment.R > /results/log_11_supp_note11_third_moment.txt     2>&1  # Supplementary Note 11, third-moment limit against single zeta values
